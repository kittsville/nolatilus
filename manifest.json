{
  "manifest_version": 3,
  "name": "Nolatilus",
  "version": "1.0.0",
  "description": "Minutes until your next Google Calendar meeting.",
  "key": "",
  "permissions": ["identity", "alarms", "storage"],
  "host_permissions": ["https://www.googleapis.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Next meeting",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "oauth2": {
    "client_id": "1034514081738-vjeqolsh4drdtcmekth6c2altjl9faoq.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/calendar.events.readonly"]
  }
}
